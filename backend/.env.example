# Copy to backend/.env and fill in what you need. Everything has a working default.

# --- LLM (writes the answers; optionally classifies messages) -------------------
# auto = Claude if ANTHROPIC_API_KEY is set, else OpenAI-compatible if OPENAI_BASE_URL
# is set, else none (template answers — the whole demo still works, no key needed)
LLM_PROVIDER=auto

# Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# Free + local: install Ollama, `ollama pull llama3.2:3b`, then:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2:3b
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=llama3.2:3b

# llm | template
ANSWER_MODE=llm
# rules | ml (trained scikit-learn model in models/) | llm
CLASSIFIER=ml

# --- retrieval ------------------------------------------------------------------
# minilm (sentence-transformers, ~90 MB download on first run) | hash (no download)
EMBEDDER=minilm
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# chroma | numpy
VECTOR_STORE=chroma

# --- misc -----------------------------------------------------------------------
# 1.0 = same stage timing as the frontend demo; 0 = as fast as possible
PIPELINE_PACING=0.6
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATA_DIR=./data
